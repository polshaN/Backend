{
  "realm": "PETADOPTION-APP",
  "enabled": true,
  "displayName": "Pet Adoption Application",
  "displayNameHtml": "<h1>Pet Adoption App</h1>",
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessTokenLifespan": 3600,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 600,
  "attributes": {
    "_browser_header.contentSecurityPolicyReportingUrl": "",
    "_browser_header.contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "_browser_header.xContentTypeOptions": "nosniff",
    "_browser_header.xFrameOptions": "SAMEORIGIN",
    "_browser_header.xRobotsTag": "none",
    "_browser_header.xXSSProtection": "1; mode=block",
    "_ui_order": "oidc,saml"
  },
  "bruteForceProtected": false,
  "defaultSignatureAlgorithm": "RS256",
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": true,
  "emailVerificationRequired": false,
  "eventsEnabled": false,
  "failureFactor": 30,
  "maxDeltaTime": 43200,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "notBefore": 0,
  "permanentLockout": false,
  "quickLoginCheckMilliSeconds": 0,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "resetPasswordAllowed": true,
  "revokeRefreshToken": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role",
        "composite": false
      },
      {
        "name": "adopter",
        "description": "Pet adopter role",
        "composite": false
      },
      {
        "name": "shelter-staff",
        "description": "Shelter staff member",
        "composite": false
      }
    ],
    "client": {
      "petadoption-client": [
        {
          "name": "user",
          "description": "User role"
        }
      ]
    }
  },
  "scopeMappings": [],
  "clientScopeMappings": {
    "petadoption-client": [
      {
        "client": "petadoption-client",
        "roles": [
          "admin",
          "adopter",
          "shelter-staff"
        ]
      }
    ]
  },
  "clients": [
    {
      "clientId": "petadoption-client",
      "name": "Pet Adoption Frontend",
      "description": "Frontend web application for pet adoption",
      "enabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080"
      ],
      "publicClient": false,
      "secret": "petadoption-secret-key-12345",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "access": {
        "view": true,
        "manage": true,
        "manage-membership": true,
        "impersonate": false,
        "configure": true
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sub",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "given_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "family_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-cli",
      "name": "Admin CLI",
      "description": "Admin CLI client for testing",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@petadoption.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "shelter-staff"
      ]
    },
    {
      "username": "adopter1",
      "email": "adopter1@petadoption.local",
      "firstName": "John",
      "lastName": "Adopter",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "adopter"
      ]
    },
    {
      "username": "adopter2",
      "email": "adopter2@petadoption.local",
      "firstName": "Jane",
      "lastName": "Smith",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "adopter"
      ]
    },
    {
      "username": "staff1",
      "email": "staff1@petadoption.local",
      "firstName": "Staff",
      "lastName": "Member",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "shelter-staff"
      ]
    }
  ]
}
